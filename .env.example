MAPPING_SALT=change-me-to-a-random-secret

# Optional: without these, generator/ falls back to a local Faker backend
# (pipeline stays fully runnable without any API key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required by the `api`/`worker` services (see docker-compose.yml, api/README.md).
# Shared secret between sanitaizer-web's server-side routes and this API —
# must match sanitaizer-web's JOBS_INTERNAL_SECRET exactly. Generate with
# `openssl rand -hex 32`.
JOBS_INTERNAL_SECRET=change-me-to-a-random-secret

# Absolute path of this repo *on the host* running docker compose — the
# worker container needs this to shell out to `docker compose` correctly
# (see docker-compose.yml `worker` service comment). e.g. /root/db-sanitization
PIPELINE_HOST_DIR=/root/db-sanitization
